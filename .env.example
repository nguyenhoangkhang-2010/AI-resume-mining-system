# Copy to .env and adjust. .env is git-ignored; never commit real secrets.

# --- Docker Compose --------------------------------------------------------
# Required: password for the MongoDB root user created on first start. The
# API receives it as MONGO_USERNAME / MONGO_PASSWORD, so no URL-encoding is
# needed; avoid the $ character, which compose treats as a variable marker.
MONGO_ROOT_PASSWORD=change-me
MONGO_ROOT_USER=resume_admin

# Host side of the API port mapping. Keep 127.0.0.1 unless a reverse proxy
# with TLS sits in front: API keys travel in request headers.
API_BIND=127.0.0.1
API_PORT=8000

# Build the llama-cpp-python backend (compiled from source, slow).
WITH_LLAMA_CPP=true

# Install Tesseract in the image (needed for OCR_ENABLED=true).
WITH_OCR=false

# --- Application settings (also work without Docker) -----------------------
MONGO_URI=mongodb://localhost:27017
# Only for a MongoDB that requires authentication:
# MONGO_USERNAME=
# MONGO_PASSWORD=
# MONGO_AUTH_SOURCE=admin
DB_NAME=resume_mining_db
MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
FAISS_INDEX_PATH=faiss_index/candidate.index

# Hugging Face token (only needed for gated models).
HF_TOKEN=

# LLM used for resume extraction: "huggingface" downloads LLM_MODEL_NAME,
# "llama_cpp" loads a local GGUF file from LLM_GGUF_MODEL_PATH.
LLM_PROVIDER=llama_cpp
LLM_MODEL_NAME=mistralai/Mistral-7B-Instruct-v0.2
LLM_GGUF_MODEL_PATH=models/mistral-7b-instruct-v0.2.Q5_K_M.gguf
LLM_DEVICE=-1
MAX_NEW_TOKENS=128
LLM_DO_SAMPLE=false

# Output limits per extractor. If the model's JSON is cut off, entries are
# lost or only the completed ones are kept; raise these for long CVs
# (generation stops at the end of the JSON, so a higher limit costs little
# when the answer is short).
LLM_EXPERIENCE_MAX_TOKENS=360
LLM_EDUCATION_MAX_TOKENS=256
LLM_PROJECTS_MAX_TOKENS=768

# Uploads: size limit in MB. Scanned (image-only) PDFs are read with OCR when
# OCR_ENABLED=true and Tesseract with the language data below is installed;
# otherwise they are flagged needs_review.
MAX_UPLOAD_MB=10
OCR_ENABLED=false
OCR_LANGUAGES=eng+vie
OCR_DPI=300

# --- Security --------------------------------------------------------------
# The API refuses to start with AUTH_ENABLED=true and no keys. Format:
# role:key pairs, role is admin (may delete) or user, keys >= 24 characters.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Send a key as "X-API-Key: <key>" or "Authorization: Bearer <key>".
AUTH_ENABLED=true
API_KEYS=
# AUTH_ENABLED=false opens every endpoint: private development machines only.

# Origins allowed to call the API from a browser, comma-separated.
CORS_ORIGINS=

# Requests per minute per key; the heavy budget covers upload, job creation,
# search and recommendations (they run the embedding model or the LLM).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_HEAVY_PER_MINUTE=20

MAX_JOB_DESCRIPTION_CHARS=50000

# Let Hugging Face model repositories run their own Python code. Leave false.
NER_TRUST_REMOTE_CODE=false

# Where answers about unfamiliar CV section headings are remembered (one
# LLM call per distinct heading, then never again). Safe to delete.
HEADING_CACHE_PATH=faiss_index/heading_cache.json

# Persist the FAISS index after this many changes (1 = after every change).
FAISS_SAVE_EVERY=1
